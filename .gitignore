/.phpunit.cache
/node_modules
# public/build is committed on purpose: .cpanel.yml copies it straight to
# public_html and does not run `npm run build` on the host. Keeping it ignored
# while part of it was committed left manifest.json pointing at chunks that
# were never pushed, so every page requested a missing app bundle.
/public/hot
/public/storage
/storage/*.key
/vendor
.env
.env.backup
.env.production
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.vscode
tmp
